// Prisma Schema for Autonomous Social Media Engine
// PostgreSQL Database Provider

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  CREATOR
}

enum PlanTier {
  FREE_TRIAL
  PRO_CREATOR
  AGENCY_SCALE
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
}

enum Platform {
  TWITTER
  LINKEDIN
  INSTAGRAM
}

enum LLMProvider {
  GEMINI
  OPENAI
  DEEPSEEK
}

enum LLMMode {
  SYSTEM_DEFAULT
  BYOK
}

enum PostStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SCHEDULED
  PUBLISHED
  FAILED
}

model User {
  id            String              @id @default(cuid())
  email         String              @unique
  name          String?
  image         String?
  role          Role                @default(CREATOR)
  passwordHash  String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  subscription  Subscription?
  connections   SocialConnection[]
  llmConfigs    LLMConfig[]
  brandProfile  BrandProfile?
  calendars     ContentCalendar[]
  auditLogs     AuditLog[]

  @@index([email])
}

model Subscription {
  id                    String              @id @default(cuid())
  userId                String              @unique
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier                  PlanTier            @default(FREE_TRIAL)
  status                SubscriptionStatus  @default(ACTIVE)
  maxSocialAccounts     Int                 @default(1)
  maxMonthlyPosts       Int                 @default(9)
  byokAllowed           Boolean             @default(false)
  autoSchedulingEnabled Boolean             @default(false)
  currentPeriodStart    DateTime            @default(now())
  currentPeriodEnd      DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
}

model SocialConnection {
  id                String              @id @default(cuid())
  userId            String
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform          Platform
  accountHandle     String
  accountName       String?
  platformAccountId String?
  accessToken       String?
  refreshToken      String?
  tokenExpiresAt    DateTime?
  isSandbox         Boolean             @default(true)
  connected         Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([userId, platform])
}

model LLMConfig {
  id              String              @id @default(cuid())
  userId          String
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider        LLMProvider         @default(GEMINI)
  mode            LLMMode             @default(SYSTEM_DEFAULT)
  apiKeyEncrypted String?
  modelName       String              @default("gemini-1.5-flash")
  isPrimary       Boolean             @default(true)
  isActive        Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}

model BrandProfile {
  id             String               @id @default(cuid())
  userId         String               @unique
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  niche          String
  targetAudience String
  brandTone      String
  timezone       String               @default("UTC")
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
}

model ContentCalendar {
  id          String                  @id @default(cuid())
  userId      String
  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String                  @default("3-Day Content Calendar")
  batchStatus String                  @default("PENDING_APPROVAL")
  niche       String
  audience    String
  tone        String
  days        Json
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  posts       Post[]
}

model Post {
  id            String                @id @default(cuid())
  calendarId    String
  calendar      ContentCalendar       @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  platform      Platform
  content       String
  mediaPrompt   String?
  mediaUrl      String?
  scheduledTime DateTime
  status        PostStatus            @default(PENDING_APPROVAL)
  externalId    String?
  externalUrl   String?
  publishedAt   DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([status, scheduledTime])
}

model AuditLog {
  id          String                  @id @default(cuid())
  userId      String
  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform    Platform
  postId      String?
  status      String
  isSandbox   Boolean                 @default(true)
  payload     Json?
  externalId  String?
  externalUrl String?
  createdAt   DateTime                @default(now())
}
