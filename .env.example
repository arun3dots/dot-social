# ================================================================
# Social Media Automation Engine - Environment Configuration
# ================================================================

# System Mode
SANDBOX_MODE=true
NODE_ENV=development
PORT=3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-me-run-openssl-rand-base64-32

# Database: PostgreSQL with Prisma ORM
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/social_media

# ----------------------------------------------------------------
# Super Admin Defaults
# ----------------------------------------------------------------
SUPER_ADMIN_EMAIL=admin@example.com

# ----------------------------------------------------------------
# AI Provider Keys (Primary: Gemini, Backups/BYOK: OpenAI, DeepSeek)
# ----------------------------------------------------------------
GEMINI_API_KEY=""
OPENAI_API_KEY=""
DEEPSEEK_API_KEY=""

# ----------------------------------------------------------------
# Authentication: Google OAuth (Required for live Google login)
# ----------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ----------------------------------------------------------------
# Social Platform Developer Credentials (Required for Live OAuth)
# ----------------------------------------------------------------
# X / Twitter API v2 (OAuth 2.0 PKCE / User Context)
TWITTER_CLIENT_ID=""
TWITTER_CLIENT_SECRET=""

# LinkedIn API v2 (Share on LinkedIn / UGC)
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# Meta / Instagram Graph API (Instagram Business / Creator)
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""

# Demo logins bypass credentials — keep FALSE in production
ALLOW_DEMO_LOGIN=false

# Super-admin password for /admin/login (generate: openssl rand -base64 24). Empty = credential login disabled.
SUPER_ADMIN_SECRET_KEY=

# Safety switch: the scheduler must not post to a real account unless this is true.
# Dispatch Now (a human posting one specific post) works regardless.
PUBLISHING_ENABLED=false

# Shared secret for the headless scheduler tick.
# Unset, /api/scheduler/run requires an ADMIN session instead.
SCHEDULER_SECRET=replace-me-with-a-random-token

# Vercel Cron secret (automatically sent as Bearer token by Vercel Cron jobs)
CRON_SECRET=replace-me-with-a-random-token

# ----------------------------------------------------------------
# Cloud Media Storage: AWS S3 or Cloudflare R2 (Free Tier)
# ----------------------------------------------------------------
# Recommended for Vercel/serverless where local filesystem is ephemeral.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="ap-south-1"
S3_BUCKET_NAME=""
# S3_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com" # (Optional: Cloudflare R2)

# LinkedIn: set to true to create posts as DRAFT (nothing appears on the feed). For testing the
# publishing pipeline; leave false/unset to publish for real.
LINKEDIN_POST_AS_DRAFT=false
DEFAULT_TIMEZONE=Asia/Kolkata

